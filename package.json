{
  "name": "echoink-agent",
  "version": "2.4.0",
  "description": "A personal knowledge agent for Obsidian that builds editable memory and grows to understand you better.",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run build:home-magic-ui-css && node esbuild.config.mjs production",
    "build:home-magic-ui-css": "node scripts/build-home-magic-ui-css.mjs",
    "check:bundle": "node scripts/check-built-bundle.mjs",
    "check:phase1-obsidian-runtime": "node scripts/check-phase1-obsidian-runtime.mjs",
    "check:public": "node scripts/check-public-files.mjs",
    "check:release": "node scripts/check-release-contract.mjs",
    "dev": "npm run build:home-magic-ui-css && node esbuild.config.mjs watch",
    "lint": "node scripts/check-obsidian-review.mjs",
    "lint:report": "eslint .",
    "lint:update-baseline": "node scripts/check-obsidian-review.mjs --write-baseline",
    "prepare": "node scripts/install-git-hooks.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:react-dom-resources": "node scripts/react-dom-script-resources-tests.mjs",
    "test:provider-settings": "node scripts/provider-settings-tests.mjs",
    "test:settings-search": "node --enable-source-maps scripts/native-settings-search-tests.mjs",
    "test:conversation-ui": "node scripts/conversation-ui-tests.mjs",
    "test:personal-memory": "node src/tests/personal-memory-tests.mjs",
    "test:system-prompt": "node src/tests/system-prompt-tests.mjs",
    "test:agent-self": "node src/tests/agent-self-tests.mjs",
    "test:dream-ledger": "node src/tests/dream-ledger-tests.mjs",
    "test:dream-growth": "node src/tests/dream-growth-tests.mjs",
    "test:developer-mode": "node scripts/developer-mode-tests.mjs",
    "test:skill-runtime": "node src/tests/skill-runtime-tests.mjs",
    "test:knowledge": "node scripts/phase3-tests.mjs",
    "test:mcp-vault": "node scripts/mcp-vault-tests.mjs",
    "verify:obsidian": "npm run check:public && npm run lint && npm run test && npm run typecheck && npm run build && npm run check:bundle",
    "package": "npm run build && node scripts/package.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "keywords": [
    "obsidian",
    "openai",
    "knowledge-management",
    "personal-agent",
    "memory"
  ],
  "author": "AKin-lvyifang",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "esbuild": "^0.25.3",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.7.0",
    "obsidian": "^1.8.7",
    "postcss": "8.5.6",
    "postcss-prefix-selector": "2.1.1",
    "tailwindcss": "4.1.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.64.0",
    "unpdf": "1.8.1",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-slot": "1.2.3",
    "brace-expansion": "5.0.9",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.23.24",
    "pinyin-pro": "3.29.3",
    "radix-ui": "1.6.7",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "3.3.1",
    "word-extractor": "1.0.4"
  },
  "overrides": {
    "framer-motion": {
      "motion-dom": "12.23.23",
      "motion-utils": "12.23.6"
    }
  }
}
