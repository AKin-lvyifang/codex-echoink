{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ES2022",
    "allowJs": false,
    "noImplicitAny": false,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "strictBindCallApply": true,
    "lib": [
      "DOM",
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/lib/utils": [
        "src/home/magic-ui/utils.ts"
      ],
      "@/components/ui/button": [
        "src/home/magic-ui/button.tsx"
      ]
    },
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/tests/**",
    "src/home/magic-ui/provenance/**"
  ]
}
